Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt" : ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      ToPort: 443
      FromPort: 443
      CidrIp: 0.0.0.0/0

commands:
  01_create_cert_dir:
    command: "mkdir -p /etc/letsencrypt/live/kairo-sengmey-dev.duckdns.org"
  02_create_dummy_cert:
    command: |
      if [ ! -f /etc/letsencrypt/live/kairo-sengmey-dev.duckdns.org/fullchain.pem ]; then
        openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
          -keyout /etc/letsencrypt/live/kairo-sengmey-dev.duckdns.org/privkey.pem \
          -out /etc/letsencrypt/live/kairo-sengmey-dev.duckdns.org/fullchain.pem \
          -subj "/CN=kairo-sengmey-dev.duckdns.org"
      fi
  03_install_certbot:
    command: |
      if command -v dnf > /dev/null 2>&1; then
        dnf install -y python3-pip augeas-libs
      else
        yum install -y python3-pip augeas-libs
      fi
      python3 -m pip install --upgrade pip
      python3 -m pip install certbot
      ln -sf /usr/local/bin/certbot /usr/bin/certbot || true
    test: "! test -f /usr/bin/certbot"

container_commands:
  01_create_webroot:
    command: "mkdir -p /var/app/current/public/.well-known/acme-challenge || true"
