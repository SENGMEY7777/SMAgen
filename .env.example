# Application
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
WORKSPACE_ROOT=./workspaces
# Command timeout is hard-capped at 30000 ms (30 seconds).
MAX_CONCURRENT_TASKS=4
COMMAND_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=10000
MAX_SELF_HEAL_RETRIES=3
ALLOW_EMAIL_SIMULATION=true

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SMAgen_db
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# DB_PASS=your_database_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/absolute/path/to/ca.pem

# JWT
# Use a long random value with at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ISSUER=ai-agent-api
JWT_AUDIENCE=ai-agent-admin
JWT_EXPIRES_IN=15m

# Gemini
# Configure GEMINI_API_KEY or GOOGLE_API_KEY.
GEMINI_API_KEY=your_gemini_api_key
# GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=10000
# USD rates per 1 million tokens; set these to the pricing for your selected model.
GEMINI_INPUT_RATE_USD_PER_1M_TOKENS=0
GEMINI_OUTPUT_RATE_USD_PER_1M_TOKENS=0

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=SMAgen <noreply@example.com>
# EMAIL_USER=your_smtp_user
# EMAIL_PASS=your_smtp_password
